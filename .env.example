# Bilads — environment variables
#
# Copy to app/.env.local (the Next.js app reads env from app/) and fill in real
# values. NEVER commit .env.local (see .gitignore).
#   cp .env.example app/.env.local

# ─────────────────────────────────────────────────────────────────────────────
# Fireworks — primary text, vision, image, embedding, and reranking inference.
# The API key is server-only. Embedding-backed retrieval is off until its
# relevance/latency evaluation gate passes; keyword retrieval remains available.
# Deterministic local fallbacks keep the demo usable when unset.
# ─────────────────────────────────────────────────────────────────────────────
FIREWORKS_API_KEY=
FIREWORKS_CHAT_MODEL=accounts/fireworks/models/qwen3p7-plus
FIREWORKS_VISION_MODEL=accounts/fireworks/models/qwen3p7-plus
FIREWORKS_IMAGE_MODEL=accounts/fireworks/models/flux-1-schnell-fp8
FIREWORKS_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
FIREWORKS_RERANK_MODEL=fireworks/qwen3-reranker-8b
FIREWORKS_EMBEDDING_DIMENSIONS=1024
SEMANTIC_RETRIEVAL_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB Atlas — production system of record, GridFS, checkpoints, and vectors.
# The URI must never use a NEXT_PUBLIC_* variable. The default database is
# `bilads`; set MONGODB_DB to use a different database on the same cluster.
# When MONGODB_URI is blank, local development uses app/.data as a fallback.
# When it is set and Atlas is unavailable, requests fail rather than diverge.
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=bilads
MONGODB_VECTOR_INDEX=creative_memory_qwen3_1024_v1

# ElevenLabs — optional approved campaign briefings. Both are server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# OpenRouter — machine-only Model Lab. Never an automatic production fallback.
OPENROUTER_API_KEY=
OPENROUTER_EVAL_MODEL=
OPENROUTER_PROVIDER_ORDER=

# ─────────────────────────────────────────────────────────────────────────────
# Google Street View — campaign simulation background (optional)
# Used by /api/streetview to composite generated ads into the real street scene.
# GOOGLE_STREET_VIEW_API_KEY takes precedence if both values are set.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_STREET_VIEW_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Browser request shaping — exact Origin the Bilads UI is served from, e.g.
# https://bilads.example.com. Required in production for JSON POST routes.
# Development defaults to http://localhost:3000 when unset. This is CSRF
# shaping, NOT authentication: without accounts, anyone who can reach the app
# can call the shared browser APIs.
# ─────────────────────────────────────────────────────────────────────────────
BILADS_APP_ORIGIN=

# ─────────────────────────────────────────────────────────────────────────────
# Bilads API key — machine bearer for external agent callers.
# /api/research and /api/generate accept it as an alternative to a same-origin
# browser request:
#   Authorization: Bearer <BILADS_API_KEY>
# ─────────────────────────────────────────────────────────────────────────────
BILADS_API_KEY=
